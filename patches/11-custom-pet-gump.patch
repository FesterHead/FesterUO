diff --git a/Scripts/Services/Pet Training/PetTrainingHelper.cs b/Scripts/Services/Pet Training/PetTrainingHelper.cs
index 6a01d94..ae0ab37 100644
--- a/Scripts/Services/Pet Training/PetTrainingHelper.cs	
+++ b/Scripts/Services/Pet Training/PetTrainingHelper.cs	
@@ -1,5 +1,6 @@
 using System;
 using Server;
+using Server.Gumps;
 using System.Collections.Generic;
 using System.Linq;
 using Server.Items;
@@ -118,6 +119,55 @@ namespace Server.Mobiles
     {
         public static bool Enabled { get { return Core.TOL; } }
 
+        public static bool HasLoreGump(Mobile m)
+        {
+            if (m == null)
+            {
+                return false;
+            }
+
+            Type t = ScriptCompiler.FindTypeByName("DashboardAnimalLoreGump");
+            return (t != null && m.HasGump(t)) || m.HasGump(typeof(NewAnimalLoreGump));
+        }
+
+        public static BaseGump FindLoreGump(Mobile m)
+        {
+            if (m == null)
+            {
+                return null;
+            }
+
+            Type t = ScriptCompiler.FindTypeByName("DashboardAnimalLoreGump");
+            if (t != null)
+            {
+                BaseGump g = m.FindGump(t) as BaseGump;
+                if (g != null)
+                {
+                    return g;
+                }
+            }
+
+            return m.FindGump<NewAnimalLoreGump>();
+        }
+
+        public static void SendLoreGump(Mobile from, BaseCreature bc)
+        {
+            if (from == null || bc == null)
+            {
+                return;
+            }
+
+            Type t = ScriptCompiler.FindTypeByName("DashboardAnimalLoreGump");
+            if (t != null)
+            {
+                BaseGump.SendGump((BaseGump)Activator.CreateInstance(t, (PlayerMobile)from, bc));
+            }
+            else
+            {
+                BaseGump.SendGump(new NewAnimalLoreGump((PlayerMobile)from, bc));
+            }
+        }
+
         public static List<TrainingPoint> TrainingPoints { get { return _TrainingPoints; } }
         public static List<TrainingPoint> _TrainingPoints;
 
