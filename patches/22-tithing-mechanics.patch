+
+        public static int GetBankGold(Mobile from)
+        {
+            if (from == null)
+                return 0;
+
+            return Banker.GetBalance(from);
+        }
+
+        public static int GetPackGold(Mobile from)
+        {
+            if (from == null || from.Backpack == null)
+                return 0;
+
+            Item[] goldItems = from.Backpack.FindItemsByType(typeof(Gold), true);
+            long total = 0;
+
+            for (int i = 0; i < goldItems.Length; ++i)
+            {
+                total += goldItems[i].Amount;
+            }
+
+            return (int)Math.Min(int.MaxValue, total);
+        }
+
+        public static int GetTotalGold(Mobile from)
+        {
+            if (from == null)
+                return 0;
+
+            long total = (long)GetBankGold(from) + (long)GetPackGold(from);
+            return (int)Math.Min(int.MaxValue, total);
+        }
+
+        private static void DeductAndTithe(Mobile from, int amount)
+        {
+            if (from == null || amount <= 0)
+                return;
+
+            if (from.TithingPoints >= MaxTithing)
+            {
+                from.SendLocalizedMessage(1060840); // You have reached the maximum amount of Tithing Points available.
+                return;
+            }
+
+            if ((from.TithingPoints + amount) > MaxTithing)
+            {
+                amount = MaxTithing - from.TithingPoints;
+            }
+
+            int bankBal = GetBankGold(from);
+            int packBal = GetPackGold(from);
+
+            // Verify the mobile still has sufficient funds across bank and backpack
+            if ((long)bankBal + (long)packBal < amount)
+            {
+                from.LocalOverheadMessage(MessageType.Regular, 0x3B2, 1060194); // You do not have enough gold to tithe that amount!
+                return;
+            }
+
+            int fromBank = Math.Min(amount, bankBal);
+            int fromPack = amount - fromBank;
+
+            // Step 1: Withdraw as much as possible from bank account ledger
+            if (fromBank > 0)
+            {
+                if (!Banker.Withdraw(from, fromBank, false))
+                {
+                    from.LocalOverheadMessage(MessageType.Regular, 0x3B2, 1060194); // You do not have enough gold to tithe that amount!
+                    return;
+                }
+            }
+
+            // Step 2: Deduct any remaining portion from backpack / nested subcontainers
+            if (fromPack > 0)
+            {
+                if (from.Backpack == null || !from.Backpack.ConsumeTotal(typeof(Gold), fromPack, true))
+                {
+                    // Roll back bank withdrawal if backpack deduction fails
+                    if (fromBank > 0)
+                    {
+                        Banker.Deposit(from, fromBank, false);
+                    }
+
+                    from.LocalOverheadMessage(MessageType.Regular, 0x3B2, 1060194); // You do not have enough gold to tithe that amount!
+                    return;
+                }
+            }
+
+            // If bank gold was consumed, display bank withdrawal notification
+            if (fromBank > 0)
+            {
+                from.SendLocalizedMessage(1155856, fromBank.ToString("N0", CultureInfo.GetCultureInfo("en-US"))); // ~1_AMOUNT~ gold has been removed from your bank box.
+            }
+
+            // Step 3: Credit character TithingPoints (1 gold = 1 point)
+            from.TithingPoints += amount;
+
+            // Devotion overhead message & shrine sound effects
+            from.LocalOverheadMessage(MessageType.Regular, 0x3B2, 1060195); // You tithe gold to the shrine as a sign of devotion.
+            from.PlaySound(0x243);
+            from.PlaySound(0x2E6);
+        }
     }
