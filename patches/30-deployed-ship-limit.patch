--- a/Scripts/Multis/Boats/BaseBoat.cs
+++ b/Scripts/Multis/Boats/BaseBoat.cs
@@ -2233,16 +2233,28 @@ namespace Server.Multis
         }
 
         public static bool HasBoat(Mobile from)
+        {
+            return Boats.Any(boat => boat.Owner == from && !boat.Deleted && boat.Map != Map.Internal && !boat.IsRowBoat);
+        }
+
+        public static bool HasReachedBoatLimit(Mobile from)
         {
             if (from.AccessLevel > AccessLevel.Player)
                 return false;
 
-            return Boats.Any(boat => boat.Owner == from && !boat.Deleted && boat.Map != Map.Internal && !boat.IsRowBoat);
+            int maxShips = Config.Get("Housing.MaxDeployedShips", 1);
+            if (maxShips <= 0)
+                return false;
+
+            return Boats.Count(boat => boat.Owner == from && !boat.Deleted && boat.Map != Map.Internal && !boat.IsRowBoat) >= maxShips;
         }
 
         public static BaseBoat GetBoat(Mobile from)
         {
-            return Boats.FirstOrDefault(boat => boat.Owner == from && !boat.Deleted && boat.Map != Map.Internal && !boat.IsRowBoat);
+            return Boats.Where(boat => boat.Owner == from && !boat.Deleted && boat.Map != Map.Internal && !boat.IsRowBoat)
+                        .OrderBy(boat => boat.Map == from.Map ? 0 : 1)
+                        .ThenBy(boat => boat.Map == from.Map ? (int)from.GetDistanceToSqrt(boat.Location) : int.MaxValue)
+                        .FirstOrDefault();
         }
 
         public static bool IsValidLocation(Point3D p, Map map)
